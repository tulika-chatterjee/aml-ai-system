{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd frontend && npm install --include=dev",
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    { "handle": "filesystem" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
